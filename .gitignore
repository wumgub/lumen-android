node_modules/
dist/
# Capacitor regenerates these from capacitor.config.ts + installed plugins on
# every `cap sync`, so they're build output, not source.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/release/
*.keystore
*.jks
# ...except the shared debug keystore CI signs with (non-secret; password is the
# standard "android"). Committing it keeps every build's signature identical so
# updates install over each other.
!ci/debug.keystore
.DS_Store
*.log
